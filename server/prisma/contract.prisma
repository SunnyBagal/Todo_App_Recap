// use prisma-8

model User {
  id       ObjectId @id @map("_id")
  email    String   @unique
  username String?
  name     String?
  posts    Post[]
  @@map("users")
}

model Todo {
  id            ObjectId    @id   @map("_id")
  title         String
  description   String
  created_At    DateTime    @default(now())
  updated_At    DateTime    @default(now())
  
}

